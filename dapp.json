{
  "name": "LIVE TRANSLATION",
  "secrets": [
    {
      "key": "LT_ADMIN_USERNAMES",
      "description": "Comma-separated platform usernames allowed to see the admin screens (cost, grants, pilot feedback, client errors). Leave empty and nobody is an admin.",
      "required": false,
      "private": false,
      "default": ""
    }
  ],
  "llm": {
    "purpose": "Translates what people say in a call into each listener's language",
    "suggested_daily_cap_cents": 500
  },
  "tests": [
    {
      "name": "Lobby renders",
      "path": "/",
      "expectText": "Start a call"
    },
    {
      "name": "Language sheet opens from a deep link",
      "path": "/?screen=languages",
      "expectSelector": "#lang-sheet"
    },
    {
      "name": "Room feed shows translated captions",
      "path": "/room/DEMOSUP",
      "expectSelector": "#feed .utterance .translation"
    },
    {
      "name": "Non-member sees the read-only preview",
      "path": "/room/DEMOSUP",
      "expectText": "Translation preview"
    },
    {
      "name": "Townhall groups listeners by language",
      "path": "/room/DEMOHALL",
      "expectSelector": "#roster .lang-group"
    },
    {
      "name": "Unknown room code explains itself",
      "path": "/room/ZZZZZZ",
      "expectText": "Room not found"
    },
    {
      "name": "Metrics screen reports latency",
      "path": "/admin/metrics",
      "expectText": "p95 latency"
    },
    {
      "name": "Group room shows the floor slots",
      "path": "/room/DEMOTEAM",
      "expectSelector": "#speaker-slots"
    },
    {
      "name": "Large room roster is aggregated",
      "path": "/room/DEMOHALL",
      "expectText": "Large room"
    },
    {
      "name": "Partial caption renders as provisional",
      "path": "/room/DEMOTEAM",
      "expectSelector": "#feed .utterance .translation.partial"
    },
    {
      "name": "Metrics reports engine and cost",
      "path": "/admin/metrics",
      "expectText": "Cost per call"
    },
    {
      "name": "Dial-in is announced but disabled",
      "path": "/room/DEMOSUP",
      "expectText": "Join by phone — coming soon"
    },
    {
      "name": "Metrics reports the three latency legs",
      "path": "/admin/metrics",
      "expectText": "End to end"
    },
    {
      "name": "A caption with no row for your language says so",
      "path": "/room/DEMOTEAM",
      "expectSelector": "#feed .utterance .translation.missing"
    },
    {
      "name": "Listening mode selector offers all three modes",
      "path": "/room/DEMOSUP",
      "expectSelector": "#audio-mode [data-audio-mode=\"both\"]"
    },
    {
      "name": "Language sheet carries the listening modes",
      "path": "/room/DEMOSUP?screen=languages",
      "expectSelector": "#audio-mode-sheet"
    },
    {
      "name": "A caption that cannot be spoken says so",
      "path": "/room/DEMOTEAM",
      "expectSelector": "#feed .utterance .audio-fallback"
    },
    {
      "name": "Audio bus demo panel renders",
      "path": "/room/DEMOSUP?audio=demo",
      "expectSelector": "#audio-demo"
    },
    {
      "name": "Metrics reports the audio leg",
      "path": "/admin/metrics",
      "expectText": "Audio leg"
    },
    {
      "name": "Metrics reports the three latency legs in Indonesian",
      "path": "/admin/metrics?lang=id",
      "expectText": "Ujung ke ujung"
    },
    {
      "name": "Metrics shows the readiness panel",
      "path": "/admin/metrics",
      "expectSelector": "#readiness"
    },
    {
      "name": "Metrics shows the failure breakdown",
      "path": "/admin/metrics",
      "expectSelector": "#failures"
    },
    {
      "name": "Metrics honours the 24 hour range",
      "path": "/admin/metrics?range=24h",
      "expectSelector": "#readiness"
    },
    {
      "name": "Alerts screen lists the rules",
      "path": "/admin/alerts",
      "expectSelector": "#alert-list"
    },
    {
      "name": "Demo call plays a translated caption",
      "path": "/demo",
      "expectSelector": "#feed .utterance .translation"
    },
    {
      "name": "Device check reports every probe",
      "path": "/admin/compat",
      "expectSelector": "#compat-table"
    },
    {
      "name": "Pilot feedback form opens from a room",
      "path": "/feedback?room=DEMOSUP&purpose=support",
      "expectSelector": "#feedback-form"
    },
    {
      "name": "Pilot feedback form is empty for a fresh visitor",
      "path": "/feedback",
      "expectText": "How well did it work?"
    },
    {
      "name": "Pilot feedback list renders",
      "path": "/admin/feedback",
      "expectSelector": "#feedback-list"
    },
    {
      "name": "Error console groups client and server errors",
      "path": "/admin/errors",
      "expectSelector": "#error-list"
    },
    {
      "name": "Listening modes read in English",
      "path": "/room/DEMOSUP?screen=languages&lang=en",
      "expectText": "What you hear"
    },
    {
      "name": "Listening modes read in Indonesian",
      "path": "/room/DEMOSUP?screen=languages&lang=id",
      "expectText": "Yang Anda dengar"
    },
    {
      "name": "In-room listening selector follows the interface language",
      "path": "/room/DEMOSUP?lang=id",
      "expectSelector": "#audio-mode [data-audio-mode=\"both\"]"
    },
    {
      "name": "The listening section names the language you hear",
      "path": "/room/DEMOSUP?lang=en",
      "expectText": "Translated captions and voice are in"
    },
    {
      "name": "Language sheet carries an interface-language picker",
      "path": "/?screen=languages",
      "expectSelector": "#ui-lang-picker"
    }
  ]
}
